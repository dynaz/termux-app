#!/bin/sh
# TermiNow bridge CLI (installed by TermiNow into the environment).
#   terminow bridge                 -> status
#   terminow bridge status          -> reachable? authenticated? selected host (sanitized)
#   terminow bridge hosts           -> list the hosts this environment may use
#   terminow bridge connect <id>    -> select a host for this terminal's CLI client
#   terminow bridge disconnect      -> clear the CLI client's selected host
#   terminow bridge doctor          -> full MCP handshake check (add -v for host details)
# Claude Code selects its own host with /bridge; the CLI client is separate.
# No token or credential is ever printed.
HELPER="$HOME/.local/share/terminow-ai/terminow-ai-bridge.py"
if [ ! -f "$HELPER" ]; then
    echo "TermiNow bridge helper is not installed. Open TermiNow and run Connect & Test." >&2
    exit 1
fi
[ "$1" = "bridge" ] && shift
sub="${1:-status}"
[ $# -gt 0 ] && shift
case "$sub" in
    status|hosts|connect|disconnect|doctor) exec python3 "$HELPER" "$sub" "$@" ;;
    *) echo "usage: terminow bridge [status|hosts|connect <id>|disconnect|doctor]" >&2; exit 2 ;;
esac
