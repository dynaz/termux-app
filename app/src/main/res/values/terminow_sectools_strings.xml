    <!-- Packet capture -->
    <string name="terminow_cap_title">Packet capture</string>
    <string name="terminow_cap_premium_what">capture and analyse packets</string>
    <string name="terminow_cap_mode_capture">Capture</string>
    <string name="terminow_cap_mode_analyze">Analyse</string>
    <string name="terminow_cap_info_title">Authorized capture only</string>
    <string name="terminow_cap_info_message">Capture only on networks and interfaces you own or are explicitly authorised to test. Captures are bounded in time and size and are written to a file in this Linux environment — nothing is uploaded anywhere automatically, and no capture content is ever sent to AI or any third-party service by TermiNow.\n\nLive capture needs the tcpdump tool, and analysis needs TShark; install them from Security tools if they are missing. Capturing on a real interface usually needs root in the environment.</string>
    <string name="terminow_cap_need_tcpdump">tcpdump is not installed. Install it from Security tools first.</string>
    <string name="terminow_cap_need_tshark">TShark is not installed. Install it from Security tools first.</string>
