<!-- Background for the anchored host-action popover (tablet / large screens): the surface colour,
     rounded corners and a subtle hairline border. The restrained shadow comes from the PopupWindow's
     elevation, not a drawable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/terminow_surface" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="@color/terminow_quick_border" />
</shape>
