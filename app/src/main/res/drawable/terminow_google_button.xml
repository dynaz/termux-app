<?xml version="1.0" encoding="utf-8"?>
<!-- The Google sign-in button: white with a gray outline (Google branding guidelines, light), darker when pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFE8EAED" />
            <stroke android:width="1dp" android:color="#FF747775" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="2dp" android:color="#FF4285F4" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="1dp" android:color="#FF747775" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
