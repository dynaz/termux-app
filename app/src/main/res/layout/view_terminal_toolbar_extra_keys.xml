<?xml version="1.0" encoding="utf-8"?>
<!-- The key bar, see TerminowKeyBar. Two rows: keys + arrows on top, tools below; both scroll
     horizontally. The keyboard button stays pinned at the right across both rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terminow_keybar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="2dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: the keys and the arrows (or the user's termux.properties keys). Fills the viewport so
             the keys spread across the width; scrolls only as a fallback on extremely narrow screens. -->
        <HorizontalScrollView
            android:id="@+id/terminow_keybar_keys"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/terminow_keybar_row"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Keys that the user set in termux.properties, instead of the keys of the bar -->
                <com.termux.shared.termux.extrakeys.ExtraKeysView
                    android:id="@+id/terminal_toolbar_extra_keys"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Row 2: the tools (clipboard/attach, QuickCut, commands/AI, More), and keys that reflowed
             down from row 1 on narrow screens. Fills the viewport width; scrolls only as a fallback. -->
        <HorizontalScrollView
            android:id="@+id/terminow_keybar_tools"
            android:layout_width="match_parent"
            android:layout_height="@dimen/terminow_keybar_height"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/terminow_keybar_row2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <ImageButton
        android:id="@+id/terminow_keybar_keyboard"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="2dp"
        android:scaleType="center" />
</LinearLayout>
