<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/terminow_host_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminow_panel_scrim">

    <!-- The width is set to a part of the screen like the Termius host panel, or all of it on narrow screens. -->
    <LinearLayout
        android:id="@+id/terminow_host_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/terminow_panel"
        android:clickable="true"
        android:fitsSystemWindows="true"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="14dp">

            <ImageButton
                android:id="@+id/terminow_host_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:contentDescription="@android:string/cancel"
                android:src="@drawable/ic_terminow_back" />

            <TextView
                android:id="@+id/terminow_host_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/terminow_new_host"
                android:textColor="@color/terminow_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/terminow_host_save"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/terminow_panel_button"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingHorizontal="22dp"
                android:text="@string/terminow_save"
                android:textAllCaps="true"
                android:textColor="@color/terminow_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/TerminowPanelSection"
                    android:layout_marginTop="6dp"
                    android:text="@string/terminow_host_address_section" />

                <LinearLayout style="@style/TerminowPanelCard">

                    <TextView
                        style="@style/TerminowPanelLabel"
                        android:labelFor="@+id/terminow_host_address"
                        android:text="@string/terminow_host_address" />

                    <EditText
                        android:id="@+id/terminow_host_address"
                        style="@style/TerminowPanelField"
                        android:inputType="textUri" />

                    <TextView
                        style="@style/TerminowPanelLabel"
                        android:labelFor="@+id/terminow_host_label"
                        android:text="@string/terminow_host_label" />

                    <EditText
                        android:id="@+id/terminow_host_label"
                        style="@style/TerminowPanelField"
                        android:inputType="text" />

                    <TextView
                        style="@style/TerminowPanelLabel"
                        android:labelFor="@+id/terminow_host_group"
                        android:text="@string/terminow_host_group" />

                    <!-- Not editable, tapping it shows the groups to pick from -->
                    <EditText
                        android:id="@+id/terminow_host_group"
                        style="@style/TerminowPanelField"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:hint="@string/terminow_host_group_none"
                        android:inputType="none" />
                </LinearLayout>

                <TextView
                    style="@style/TerminowPanelSection"
                    android:text="@string/terminow_host_ssh_mosh" />

                <LinearLayout style="@style/TerminowPanelCard">

                    <LinearLayout style="@style/TerminowPanelToggleRow">

                        <TextView
                            style="@style/TerminowPanelToggleTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/terminow_host_ssh" />

                        <!-- SSH is always used, also by Mosh to start its session -->
                        <Switch
                            android:id="@+id/terminow_host_ssh"
                            style="@style/TerminowPanelSwitch"
                            android:checked="true"
                            android:clickable="false"
                            tools:ignore="UseSwitchCompatOrMaterialXml" />
                    </LinearLayout>

                    <LinearLayout style="@style/TerminowPanelToggleRow">

                        <TextView
                            style="@style/TerminowPanelToggleTitle"
                            android:text="@string/terminow_host_mosh_title" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/terminow_host_mosh_url"
                            android:textColor="@color/terminow_panel_accent"
                            android:textSize="13sp"
                            android:textStyle="italic" />

                        <Switch
                            android:id="@+id/terminow_host_mosh"
                            style="@style/TerminowPanelSwitch"
                            tools:ignore="UseSwitchCompatOrMaterialXml" />
                    </LinearLayout>

                    <TextView
                        style="@style/TerminowPanelLabel"
                        android:layout_marginTop="4dp"
                        android:labelFor="@+id/terminow_host_port"
                        android:text="@string/terminow_host_port" />

                    <EditText
                        android:id="@+id/terminow_host_port"
                        style="@style/TerminowPanelField"
                        android:hint="@string/terminow_host_port_default"
                        android:inputType="number"
                        android:maxLength="5" />

                    <TextView
                        style="@style/TerminowPanelLabel"
                        android:labelFor="@+id/terminow_host_username"
                        android:text="@string/terminow_host_username" />

                    <EditText
                        android:id="@+id/terminow_host_username"
                        style="@style/TerminowPanelField"
                        android:inputType="textVisiblePassword" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/terminow_host_password"
                            style="@style/TerminowPanelField"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/terminow_host_password"
                            android:inputType="textPassword" />

                        <TextView
                            android:id="@+id/terminow_host_keys"
                            style="@style/TerminowPanelLink"
                            android:text="@string/terminow_host_keys" />
                    </LinearLayout>

                    <TextView
                        style="@style/TerminowPanelLabel"
                        android:layout_marginTop="18dp"
                        android:labelFor="@+id/terminow_host_key"
                        android:text="@string/terminow_host_key" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/terminow_host_key"
                            style="@style/TerminowPanelField"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="@string/terminow_host_key_hint"
                            android:inputType="textVisiblePassword" />

                        <TextView
                            android:id="@+id/terminow_host_key_remove"
                            style="@style/TerminowPanelLink"
                            android:text="@string/terminow_host_key_remove"
                            android:textColor="@color/terminow_text_secondary" />
                    </LinearLayout>

                    <TextView
                        style="@style/TerminowPanelLabel"
                        android:labelFor="@+id/terminow_host_snippet"
                        android:text="@string/terminow_host_snippet" />

                    <!-- Not editable, tapping it shows the snippets to pick from -->
                    <EditText
                        android:id="@+id/terminow_host_snippet"
                        style="@style/TerminowPanelField"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:hint="@string/terminow_host_snippet_none"
                        android:inputType="none" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/terminow_host_credentials_note"
                        android:textColor="@color/terminow_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
