<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Play build: shared storage only through folders that the user picks with the
     Storage Access Framework. All files access is removed, also if a library would add it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />

</manifest>
