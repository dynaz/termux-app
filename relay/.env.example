# TermiNow MCP relay configuration. Copy to .env and edit, or set these in your process manager.

# Where the relay binds (behind a TLS reverse proxy). Keep it on localhost if the proxy is local.
RELAY_HOST=127.0.0.1
RELAY_PORT=8787

# The public HTTPS origin AI clients use. MUST be https:// in production: ChatGPT and Claude
# Desktop refuse plain http. This appears in OAuth metadata and in redirect validation.
RELAY_PUBLIC_URL=https://relay.example.com

# Device tokens: token=userId pairs, comma-separated. Each TermiNow device is given a token
# (MCP Bridge -> Relay -> Connect in the app shows it once). Map it to that user's id here.
#   RELAY_DEVICE_TOKENS=dvc_abc123=alice,dvc_def456=bob
RELAY_DEVICE_TOKENS=

# Pairing codes: code=userId pairs. A human enters the code on the OAuth consent screen to prove
# they are that user. Rotate these; treat them as passwords.
#   RELAY_PAIRING_CODES=PAIR-ALICE-7Q2=alice
RELAY_PAIRING_CODES=

# Token lifetimes and how long a relayed request waits for the device.
RELAY_ACCESS_TOKEN_TTL_MS=3600000
RELAY_REQUEST_TIMEOUT_MS=60000

# Allow dynamic client registration (RFC 7591). Some ChatGPT/Claude Desktop builds need it.
RELAY_ALLOW_DCR=true
