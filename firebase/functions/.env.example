# Copy to .env.<firebase project id>, like .env.linex-bf945, and fill in. Not secret.
# The secret WHMCS_SYNC_SECRET is set with: firebase functions:secrets:set WHMCS_SYNC_SECRET
FUNCTIONS_REGION=
PLAY_PACKAGE_NAME=com.terminow
# The Play product and base plans that are TermiNow Premium. Add "whmcsProductId": <id of the
# free WHMCS product for Google Play subscribers> to each plan once that product exists.
PLAY_PRODUCT_MAP={"terminow_premium":{"monthly":{"tier":"premium"},"yearly":{"tier":"premium"}}}
PLAY_RTDN_TOPIC=
WHMCS_SYNC_URL=
