# Copy to .env.<firebase project id>, like .env.linex-bf945, and fill in. Not secret.
# The secrets WHMCS_SYNC_SECRET and WHMCS_ENTITLEMENT_SECRET are set with:
#   firebase functions:secrets:set WHMCS_SYNC_SECRET
#   firebase functions:secrets:set WHMCS_ENTITLEMENT_SECRET
FUNCTIONS_REGION=
PLAY_PACKAGE_NAME=com.terminow
# The Play product and base plans that are TermiNow Premium. Add "whmcsProductId": <id of the
# free WHMCS product for Google Play subscribers> to each plan once that product exists.
PLAY_PRODUCT_MAP={"terminow_premium":{"monthly":{"tier":"premium"},"yearly":{"tier":"premium"}}}
PLAY_RTDN_TOPIC=
WHMCS_SYNC_URL=
# WHMCS -> Firebase entitlement writer (whmcsEntitlement HTTP function). WHMCS_ENTITLEMENT_SECRET
# (Secret Manager) is the same value as the WHMCS addon setting "Entitlement sync secret". Leave
# WHMCS_GRANTS_PREMIUM empty to RECORD the whmcs source without granting Premium (premium.php stays
# the path); set it to 1 only at the reviewed go-live to let an Active WHMCS service grant Premium.
WHMCS_GRANTS_PREMIUM=
