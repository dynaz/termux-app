{
  "$comment": "Managed MCP task policy for the mcp-audit-fixes worktree. Lets tasks read, edit and run the project's tests; blocks deploy, push, network egress and anything touching credentials. See the mcp-audit-fixes branch.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Bash(./gradlew :app:testFullDebugUnitTest:*)",
      "Bash(./gradlew :app:compileFullDebugJavaWithJavac:*)",
      "Bash(./gradlew :app:test:*)",
      "Bash(./gradlew test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git checkout -- :*)",
      "Bash(git log:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(./gradlew bundlePlayRelease:*)",
      "Bash(./gradlew bundle:*)",
      "Bash(./gradlew publish:*)",
      "Bash(./gradlew assembleRelease:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(docker:*)",
      "Bash(systemctl:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(ssh-keygen:*)",
      "Bash(puttygen:*)",
      "Bash(keytool:*)",
      "Bash(gpg:*)",
      "Bash(openssl:*)",
      "Read(/root/.secrets/**)",
      "Read(/root/.ssh/**)",
      "Read(/root/.terminow/**)",
      "Read(/root/*.jks)",
      "Read(/root/*.password)",
      "Read(/root/whmcs-shared-secret.txt)",
      "Read(/sdcard/**)",
      "Read(/data/data/com.terminow/**)",
      "Read(./**/key.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./app/terminow-billing.properties)",
      "Edit(./**/*.jks)",
      "Edit(./app/terminow-billing.properties)",
      "Write(./app/terminow-billing.properties)"
    ]
  }
}
